---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	collect(collect)
	select(select)
	report(report)
	verify(verify)
	gate(gate)
	review(review)
	rejected(rejected)
	publish(publish)
	__end__([<p>__end__</p>]):::last
	__start__ --> collect;
	collect --> select;
	gate -.-> publish;
	gate -.-> review;
	report --> verify;
	review -.-> publish;
	review -.-> rejected;
	select -.-> report;
	select -.-> verify;
	verify --> gate;
	publish --> __end__;
	rejected --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
